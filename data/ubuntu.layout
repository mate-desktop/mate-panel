[Toplevel top]
expand=true
orientation=top
size=24

[Toplevel bottom]
expand=true
orientation=bottom
size=24

[Object menu-bar]
object-type=menu-bar
toplevel-id=top
pack-index=0
locked=true

[Object firefox]
locked=True
launcher-location=/usr/share/applications/firefox.desktop
toplevel-id=top
object-type=launcher
menu-path=applications:/
pack-index=1

[Object notification-area]
object-type=applet
applet-iid=NotificationAreaAppletFactory::NotificationArea
toplevel-id=top
pack-type=end
pack-index=2
locked=true

[Object clock]
object-type=applet
applet-iid=ClockAppletFactory::ClockApplet
toplevel-id=top
pack-type=end
pack-index=1
locked=true

[Object shutdown]
action-type=shutdown
object-type=action
toplevel-id=top
pack-type=end
pack-index=0
locked=true

[Object show-desktop]
object-type=applet
applet-iid=WnckletFactory::ShowDesktopApplet
toplevel-id=bottom
pack-index=0
locked=true

[Object window-list]
object-type=applet
applet-iid=WnckletFactory::WindowListApplet
toplevel-id=bottom
pack-index=1
locked=true

[Object workspace-switcher]
object-type=applet
applet-iid=WnckletFactory::WorkspaceSwitcherApplet
toplevel-id=bottom
pack-type=end
pack-index=1
locked=true

[Object trashapplet]
locked=True
toplevel-id=bottom
applet-iid=TrashAppletFactory::TrashApplet
object-type=applet
pack-type=end
pack-index=0
